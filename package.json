{
  "name": "skillbridge-student-skill-gap-analyzer",
  "version": "1.0.0",
  "description": "Student Skill Gap Analyzer website built with TypeScript, JavaScript, Tailwind CSS, and Regular CSS",
  "main": "script.js",
  "scripts": {
    "build:ts": "tsc",
    "build:css": "tailwindcss -i ./src/tailwind.css -o ./dist/tailwind.css --minify",
    "build": "npm run build:ts && npm run build:css",
    "watch:ts": "tsc --watch",
    "watch:css": "tailwindcss -i ./src/tailwind.css -o ./dist/tailwind.css --watch"
  },
  "keywords": [
    "skill-gap-analyzer",
    "student-career",
    "typescript",
    "javascript",
    "tailwind-css",
    "css"
  ],
  "author": "SkillBridge",
  "license": "MIT",
  "devDependencies": {
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.4.5"
  }
}
